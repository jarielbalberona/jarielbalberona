  "free_text_templates": [
    {
      "id": "why_new_role",
      "match_any": ["why are you looking for a new role", "why are you seeking a new role"],
      "template": "I'm looking for a senior hands-on engineering role where I can apply my full-stack and platform experience while working more deeply on AI-native products and agentic engineering systems."
    },
    {
      "id": "next_role",
      "match_any": ["what are you looking for in your next role", "what do you want in your next role"],
      "template": "A senior hands-on product or platform engineering role with meaningful technical ownership, ideally involving AI-native products, agentic systems, developer tooling, or complex SaaS engineering."
    },
    {
      "id": "why_hire",
      "match_any": ["why should we hire you", "why are you a good fit", "why should you be considered"],
      "template": "I bring 10+ years of production software engineering experience across product, frontend, backend, data, cloud, and delivery, with recent hands-on work building AI-native and agentic systems. I can own engineering problems end to end rather than operating within a narrow layer of the stack."
    },
    {
      "id": "biggest_strength",
      "match_any": ["biggest strength", "greatest strength"],
      "template": "End-to-end technical ownership. I can take ambiguous product requirements through architecture, implementation, verification, deployment, and production operation."
    },
    {
      "id": "ai_experience_detail",
      "match_any": ["describe your ai experience", "tell us about your ai experience", "summarize your ai experience"],
      "template": "I have 2+ years of practical AI-product and AI-native engineering experience, including AI analytics interfaces, agent workflows, repository-grounded coding agents, tool-enabled execution, automated verification, and controlled release systems."
    },
    {
      "id": "leaving_current_employer",
      "match_any": ["why are you leaving your current employer", "reason for leaving your current employer", "reason for leaving your current role"],
      "template": "I'm currently available for a new full-time engagement and am focusing on senior engineering roles that align strongly with my product/platform and AI-native engineering experience."
    }
  ]
