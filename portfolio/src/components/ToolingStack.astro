---
import { toolingGroups } from '../data/tooling';
---

<section class="mb-20 border-t border-line pt-10">
  <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Working stack</p>
  <h2 class="max-w-2xl text-3xl font-semibold tracking-tight text-ink leading-tight">
    Tools matter only when they reflect real system behavior.
  </h2>
  <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
    This is the current working surface across frontend, backend, data, infrastructure, automation, and applied AI.
  </p>

  <div class="mt-10 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
    {
      toolingGroups.map((group) => (
        <article class="border-t border-line pt-5">
          <h3 class="text-xl font-semibold tracking-tight text-ink">{group.title}</h3>
          <ul class="mt-5 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
            {group.items.map((item) => (
              <li>{item.label}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
