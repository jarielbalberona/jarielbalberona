---
import { navItems, siteMeta } from '../data/site';

interface Props {
  activeNav: string;
}

const { activeNav } = Astro.props;
---

<header class="pt-6">
  <div class="mx-auto flex w-[min(100%-1.5rem,72rem)] flex-wrap items-center justify-between gap-4 border border-line/90 bg-paper-panel/90 px-4 py-4 shadow-[0_18px_48px_rgba(31,40,43,0.08)] backdrop-blur">
    <a href="/" class="font-display text-lg font-semibold tracking-[0.02em] text-ink no-underline">
      {siteMeta.name}
      <span class="mt-1 block font-sans text-sm font-medium text-ink-soft">{siteMeta.shortTitle}</span>
    </a>
    <nav class="flex flex-wrap gap-2" aria-label="Primary">
      {
        navItems.map((item) => {
          const active = activeNav === item.key;

          return (
            <a
              href={item.href}
              class:list={[
                'rounded-full px-4 py-2 text-sm font-medium no-underline transition-colors',
                active ? 'bg-ink text-paper-panel' : 'text-ink-soft hover:bg-ink hover:text-paper-panel',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
