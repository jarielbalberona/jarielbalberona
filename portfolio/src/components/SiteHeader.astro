---
import { navItems, siteMeta } from '../data/site';

interface Props {
  activeNav: string;
}

const { activeNav } = Astro.props;
---

<header class="pt-8 md:pt-12">
  <div class="mx-auto flex w-full max-w-4xl flex-wrap items-center justify-between gap-6 px-6">
    <a href="/" class="text-lg font-semibold tracking-tight text-ink no-underline">
      {siteMeta.name}
      <span class="mt-0.5 block text-sm font-medium text-ink-soft">{siteMeta.shortTitle}</span>
    </a>
    <nav class="flex flex-wrap gap-4 md:gap-6" aria-label="Primary">
      {
        navItems.map((item) => {
          const active = activeNav === item.key;

          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'text-sm font-medium no-underline transition-colors',
                active ? 'text-ink' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
