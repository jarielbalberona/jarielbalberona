---
interface Props {
  left: string;
  right: string;
}

const { left, right } = Astro.props;
---

<footer class="pb-12 pt-12">
  <div class="mx-auto flex w-full max-w-4xl flex-wrap justify-between gap-4 border-t border-line px-6 py-6 text-sm text-ink-soft">
    <span>{left}</span>
    <span>{right}</span>
  </div>
</footer>
