---
import { footerLinks } from '../data/site';

interface Props {
  left: string;
  right: string;
}

const { left, right } = Astro.props;
---

<footer class="pb-12 pt-12">
  <div class="mx-auto flex w-full max-w-4xl flex-wrap items-center justify-between gap-4 border-t border-line px-6 py-6 text-sm text-ink-soft">
    <span>{left}</span>
    <nav class="flex flex-wrap gap-5" aria-label="Secondary">
      {footerLinks.map((item) => <a href={item.href} class="text-ink-soft no-underline hover:text-ink">{item.label}</a>)}
    </nav>
    <span>{right}</span>
  </div>
</footer>
