---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entries = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout
  title="Work | Jariel Balberona"
  description="Selected product and platform work from Jariel Balberona, focused on maintainability, scalability, reliability, and practical engineering scope."
  activeNav="work"
  footerLeft="Selected work only"
  footerRight="No filler project grid"
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Work</p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-tight">
      Selected proof, not project wallpaper.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      This page is deliberately curated. The standard is simple: real scope, real constraints, and enough technical
      substance to survive scrutiny.
    </p>
  </section>

  <section class="space-y-16">
    {
      entries.map((entry) => (
        <article class="border-t border-line pt-8">
          <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">{entry.data.status}</p>
          <h2 class="text-3xl font-semibold tracking-tight text-ink">{entry.data.title}</h2>
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-soft">{entry.data.summary}</p>
          <div class="mt-5 flex flex-wrap gap-3 text-xs font-mono uppercase tracking-widest text-ink-soft">
            <span>{entry.data.timeframe}</span>
            <span>•</span>
            <span>{entry.data.stack.join(' / ')}</span>
          </div>
          <ul class="mt-6 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
            {entry.data.highlights.map((item) => <li>{item}</li>)}
          </ul>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href={`/work/${entry.id.replace(/\.md$/, '')}`} class="inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft transition-colors">Read project details</a>
            {entry.data.liveUrl && (
              <a href={entry.data.liveUrl} class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">
                Visit live site
              </a>
            )}
          </div>
        </article>
      ))
    }
  </section>

  <section class="mt-24 border-t border-line pt-10">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Why this stays curated</p>
    <h2 class="text-2xl font-semibold tracking-tight text-ink">Signal matters more than volume.</h2>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-soft">
      This section exists for work that demonstrates architecture, delivery, and codebase health. If an entry
      does not add technical proof, it does not belong here.
    </p>
  </section>
</SiteLayout>
