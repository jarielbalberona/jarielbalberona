---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entries = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout
  title="Work | Jariel Balberona"
  description="Selected product and platform work from Jariel Balberona, focused on maintainability, scalability, reliability, and practical engineering scope."
  activeNav="work"
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Work</p>
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-ink leading-tight">
      Product and platform work across operations, planning, analytics, and modernization.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      These projects show the kind of work I do best: messy constraints, structural decisions, and systems that need to stay reliable as they grow.
    </p>
  </section>

  <section class="space-y-16">
    {
      entries.map((entry) => (
        <article class="border-t border-line pt-8">
          <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">{entry.data.status}</p>
          <h2 class="text-3xl font-semibold tracking-tight text-ink">{entry.data.title}</h2>
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-soft">{entry.data.summary}</p>
          <div class="mt-5 flex flex-wrap gap-3 text-xs font-mono uppercase tracking-widest text-ink-soft">
            <span>{entry.data.timeframe}</span>
            <span>•</span>
            <span>{entry.data.role}</span>
            <span>•</span>
            <span>{entry.data.stack.join(' / ')}</span>
          </div>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            <div class="border-t border-line pt-4">
              <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">Context</p>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{entry.data.context}</p>
            </div>
            <div class="border-t border-line pt-4">
              <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">Why it mattered</p>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{entry.data.impact}</p>
            </div>
          </div>
          <div class="mt-6 grid gap-6 md:grid-cols-3">
            <div class="border-t border-line pt-4">
              <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">What I owned</p>
              <ul class="mt-3 space-y-2 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
                {entry.data.ownership.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="border-t border-line pt-4">
              <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">Constraints</p>
              <ul class="mt-3 space-y-2 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
                {entry.data.constraints.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="border-t border-line pt-4">
              <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">What I changed</p>
              <ul class="mt-3 space-y-2 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
                {entry.data.changes.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href={`/work/${entry.id.replace(/\.md$/, '')}`} class="inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft transition-colors">Read project details</a>
            {entry.data.liveUrl && (
              <a href={entry.data.liveUrl} class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">
                Visit live site
              </a>
            )}
          </div>
        </article>
      ))
    }
  </section>

</SiteLayout>
