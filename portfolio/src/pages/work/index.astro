---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout
  title="Work | Jariel Balberona"
  description="Selected product, platform, and AI-native engineering work from Jariel Balberona."
  activeNav="work"
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Work</p>
    <h1 class="max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">
      Selected evidence across product ownership, platform engineering, and production delivery.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Ordr.now is the anchor case study. Earlier work is kept concise and bounded to responsibilities I can personally attribute.
    </p>
  </section>

  <section class="space-y-12" aria-label="Selected work">
    {entries.map((entry) => (
      <article class="border-t border-line pt-6">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">{entry.data.status}</p>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink">{entry.data.title}</h2>
          </div>
          <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">{entry.data.timeframe}</p>
        </div>
        <p class="mt-2 text-sm font-medium text-ink">{entry.data.role}</p>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-soft">{entry.data.summary}</p>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">Problem</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{entry.data.context}</p>
          </div>
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">Capability demonstrated</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{entry.data.impact}</p>
          </div>
        </div>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href={`/work/${entry.id}`} class="inline-flex text-sm font-semibold text-ink underline decoration-line underline-offset-4 hover:decoration-ink">Read details</a>
          {entry.data.liveUrl && <a href={entry.data.liveUrl} class="inline-flex text-sm font-semibold text-ink-soft underline decoration-line underline-offset-4 hover:text-ink hover:decoration-ink">External site</a>}
        </div>
      </article>
    ))}
  </section>
</SiteLayout>
