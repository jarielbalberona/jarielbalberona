---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const owned = entries.find((entry) => entry.id === 'ordr-now');
const earlier = entries.filter((entry) => entry.id !== 'ordr-now');
---

<SiteLayout
  title="Work | Jariel Balberona"
  description="Selected product, platform, and AI-native engineering work from Jariel Balberona."
  activeNav="work"
>
  <section class="mb-16">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Work</p>
    <h1 class="max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">
      One product I own end to end, and the roles that came before it.
    </h1>
  </section>

  {owned && (
    <section class="mb-20 border-t border-line pt-8" aria-labelledby="owned-heading">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Product I own</p>
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="owned-heading" class="text-3xl font-semibold tracking-tight text-ink">{owned.data.title}</h2>
        <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">{owned.data.timeframe}</p>
      </div>
      <p class="mt-2 text-sm font-medium text-ink">{owned.data.role}</p>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-soft">{owned.data.summary}</p>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">Problem</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{owned.data.context}</p>
        </div>
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">What I own</p>
          <ul class="mt-2 space-y-1 pl-5 text-sm leading-relaxed text-ink-soft list-disc marker:text-line">
            {owned.data.ownership.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="mt-7 flex flex-wrap gap-4">
        <a href={`/work/${owned.id}`} class="inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft">Read the case study</a>
        <a href="/work/ordr-now#offline-recovery-and-idempotent-synchronization" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink">Offline recovery proof</a>
        {owned.data.liveUrl && <a href={owned.data.liveUrl} data-analytics-event="ordr_now_click" data-analytics-location="work_index" class="inline-flex items-center text-sm font-semibold text-ink-soft underline decoration-line underline-offset-4 hover:text-ink hover:decoration-ink">Visit Ordr.now</a>}
      </div>
    </section>
  )}

  <section class="border-t border-line pt-8" aria-labelledby="earlier-heading">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Earlier roles</p>
    <h2 id="earlier-heading" class="max-w-2xl text-2xl font-semibold leading-tight tracking-tight text-ink">Kept concise, and limited to responsibilities I can personally attribute.</h2>
    <ol class="mt-8 space-y-8">
      {earlier.map((entry) => (
        <li class="border-t border-line pt-5">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="text-xl font-semibold tracking-tight text-ink">
              <a href={`/work/${entry.id}`} class="underline decoration-line underline-offset-4 hover:decoration-ink">{entry.data.title}</a>
            </h3>
            <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">{entry.data.timeframe}</p>
          </div>
          <p class="mt-1 text-sm font-medium text-ink">{entry.data.role}</p>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-soft">{entry.data.summary}</p>
        </li>
      ))}
    </ol>
  </section>
</SiteLayout>
