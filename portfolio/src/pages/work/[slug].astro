---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work');

  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<SiteLayout
  title={`${entry.data.title} | Work | Jariel Balberona`}
  description={entry.data.summary}
  activeNav="work"
  footerLeft="Selected work only"
  footerRight="Public proof with real constraints"
>
  <article>
    <section class="mb-16">
      <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">{entry.data.status}</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-tight">{entry.data.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">{entry.data.summary}</p>
      <div class="mt-6 flex flex-wrap gap-3 text-xs font-mono uppercase tracking-widest text-ink-soft">
        <span>{entry.data.timeframe}</span>
        <span>•</span>
        <span>{entry.data.role}</span>
        <span>•</span>
        <span>{entry.data.stack.join(' / ')}</span>
      </div>
      <ul class="mt-8 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line max-w-2xl">
        {entry.data.highlights.map((item) => <li>{item}</li>)}
      </ul>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="border-t border-line pt-4">
          <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">Context</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{entry.data.context}</p>
        </div>
        <div class="border-t border-line pt-4">
          <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">Why it mattered</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{entry.data.impact}</p>
        </div>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <div class="border-t border-line pt-4">
          <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">What I owned</p>
          <ul class="mt-3 space-y-2 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
            {entry.data.ownership.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="border-t border-line pt-4">
          <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">Constraints</p>
          <ul class="mt-3 space-y-2 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
            {entry.data.constraints.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="border-t border-line pt-4">
          <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">What I changed</p>
          <ul class="mt-3 space-y-2 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
            {entry.data.changes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/work" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Back to work</a>
        {entry.data.liveUrl && (
          <a href={entry.data.liveUrl} class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">
            Visit live site
          </a>
        )}
      </div>
    </section>

    <section class="border-t border-line pt-10 text-ink [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-ink [&_h2:first-child]:mt-0 [&_p]:mt-5 [&_p]:max-w-2xl [&_p]:text-base [&_p]:leading-relaxed [&_p]:text-ink-soft [&_ul]:mt-5 [&_ul]:space-y-3 [&_ul]:pl-5 [&_ul]:text-base [&_ul]:leading-relaxed [&_ul]:text-ink-soft [&_ul]:list-disc [&_ul]:marker:text-line">
      <Content />
    </section>
  </article>
</SiteLayout>
