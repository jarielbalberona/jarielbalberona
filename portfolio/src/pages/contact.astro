---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteMeta } from '../data/site';

const goodFit = [
  'React and TypeScript systems that need stronger structure, maintainability, or performance',
  'Product and platform architecture that needs to scale without turning into churn',
  'Shipping end-to-end features across frontend, backend, and infrastructure',
  'Senior IC or hands-on product engineering work where execution quality matters',
];

const badFit = [
  'Generic “full-service digital solutions” positioning',
  'Turning the site into a content funnel',
  'Trying to impress with stack logos, vanity metrics, or trend language',
  'Outsourcing responsibility to AI and calling it leverage',
];
---

<SiteLayout
  title="Contact | Jariel Balberona"
  description="Contact Jariel Balberona for senior software engineering, product architecture, and production system work."
  activeNav="contact"
  footerLeft="Direct contact only"
  footerRight="No form, no funnel, no noise"
>
  <section class="mb-9 border border-line bg-paper-panel/95 p-8 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
    <div class="mb-4 inline-flex rounded-full bg-moss px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent-strong">
      Contact
    </div>
    <h1 class="font-display text-5xl leading-[0.98] tracking-[-0.04em] text-ink sm:text-7xl">Reach out if the work fits.</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-ink-soft">
      Best fit: serious product and engineering work where architecture, maintainability, scalability, reliability, and
      end-to-end delivery actually matter.
    </p>
  </section>

  <section class="mb-9 grid gap-4 md:grid-cols-3">
    <article class="border border-line bg-paper-panel/90 p-5 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">Email</p>
      <h2 class="font-display text-2xl text-ink">
        <a class="no-underline" href={`mailto:${siteMeta.email}`}>{siteMeta.email}</a>
      </h2>
      <p class="mt-3 text-sm leading-7 text-ink-soft">Best for direct conversations about work, consulting, or collaboration.</p>
    </article>
    <article class="border border-line bg-paper-panel/90 p-5 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">LinkedIn</p>
      <h2 class="font-display text-2xl text-ink">
        <a class="no-underline" href={siteMeta.linkedin}>jarielbalberona</a>
      </h2>
      <p class="mt-3 text-sm leading-7 text-ink-soft">Use this if you want the broader professional profile and network context.</p>
    </article>
    <article class="border border-line bg-paper-panel/90 p-5 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">GitHub</p>
      <h2 class="font-display text-2xl text-ink">
        <a class="no-underline" href={siteMeta.github}>github.com/jarielbalberona</a>
      </h2>
      <p class="mt-3 text-sm leading-7 text-ink-soft">Use this if you want to inspect the repository surface and public engineering material.</p>
    </article>
  </section>

  <section class="grid gap-5 md:grid-cols-2">
    <article class="border border-line bg-paper-panel/90 p-6 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">Good fit</p>
      <h2 class="font-display text-4xl leading-tight text-ink">Work I am well suited for</h2>
      <ul class="mt-4 space-y-3 pl-5 text-sm leading-7 text-ink">
        {goodFit.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article class="border border-line bg-paper-panel/90 p-6 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">Bad fit</p>
      <h2 class="font-display text-4xl leading-tight text-ink">Things I am not trying to signal</h2>
      <ul class="mt-4 space-y-3 pl-5 text-sm leading-7 text-ink">
        {badFit.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>
</SiteLayout>
