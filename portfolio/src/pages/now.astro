---
import SiteLayout from '../layouts/SiteLayout.astro';
import { currentFocus, notOptimizingFor, nowMeta, priorities, rightNow } from '../data/now';
---

<SiteLayout
  title="Now | Jariel Balberona"
  description="Current work, priorities, and direction for Jariel Balberona."
  activeNav="now"
  footerLeft="Current work only"
  footerRight="If this page becomes stale, it needs updating or cutting"
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Now</p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-tight">
      What I am actively building and tightening.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">{nowMeta.intro}</p>
    <p class="mt-4 text-sm font-mono text-ink-soft">{nowMeta.updatedLabel}</p>
  </section>

  <section class="mb-20 grid gap-8 md:grid-cols-3">
    {
      currentFocus.map((item) => (
        <article class="border-t border-line pt-5">
          <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">{item.kicker}</p>
          <h2 class="text-xl font-semibold tracking-tight text-ink">{item.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{item.body}</p>
        </article>
      ))
    }
  </section>

  <section class="mb-24 grid gap-12 md:grid-cols-2">
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Right now</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">What I am spending time on</h2>
      <ul class="mt-5 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
        {rightNow.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Intentionally not doing</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">What I am not spending energy on</h2>
      <ul class="mt-5 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
        {notOptimizingFor.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>

  <section class="border-t border-line pt-10">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Immediate priorities</p>
    <h2 class="text-2xl font-semibold tracking-tight text-ink">Current emphasis</h2>
    <ul class="mt-8 divide-y divide-line text-sm leading-relaxed text-ink">
      {
        priorities.map((item) => (
          <li class="py-4">
            <strong class="font-medium text-ink">{item.label}:</strong> <span class="text-ink-soft">{item.body}</span>
          </li>
        ))
      }
    </ul>
  </section>
</SiteLayout>
