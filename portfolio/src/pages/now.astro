---
import SiteLayout from '../layouts/SiteLayout.astro';
import { currentDirection, currentFocus, nowMeta } from '../data/now';
---

<SiteLayout
  title="Now | Jariel Balberona"
  description="Jariel Balberona's current work across Ordr.now, AI-native product-development systems, and production engineering."
  activeNav="now"
>
  <section class="mb-16">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Now</p>
    <h1 class="text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">What I am focused on now.</h1>
    <p class="mt-5 text-sm font-mono text-ink-soft">{nowMeta.updatedLabel}</p>
  </section>

  <section class="mb-16 space-y-8" aria-label="Current focus">
    {currentFocus.map((item) => (
      <article class="max-w-3xl border-t border-line pt-5">
        <h2 class="text-xl font-semibold tracking-tight text-ink">{item.title}</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">{item.body}</p>
      </article>
    ))}
  </section>

  <section class="max-w-3xl border-t border-line pt-8">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Direction</p>
    <ul class="mt-5 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
      {currentDirection.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</SiteLayout>
