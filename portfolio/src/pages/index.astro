---
import { getCollection } from 'astro:content';
import ToolingStack from '../components/ToolingStack.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const [featuredWork] = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((entry) => entry.data.featured);

const proofBar = [
  { label: 'Experience', value: '9+ years', detail: 'shipping production software across product, platform, and delivery work' },
  { label: 'Role', value: 'Senior software engineer', detail: 'hands-on across frontend, backend, architecture, and delivery systems' },
  { label: 'Core stack', value: 'TypeScript, Node.js, React, PostgreSQL, AWS', detail: 'plus automation tooling, CI/CD, and applied AI workflow support' },
  { label: 'Focus', value: 'Architecture, backend, infra, automation, applied AI', detail: 'systems that stay operable under real delivery pressure' },
];

const focusAreas = [
  {
    title: 'Production systems',
    body: 'Backend architecture, APIs, data flow, and state boundaries that can survive real operational load.',
  },
  {
    title: 'Infrastructure and reliability',
    body: 'AWS, delivery workflows, environment discipline, observability, and failure-aware implementation.',
  },
  {
    title: 'Automation and orchestration',
    body: 'Webhooks, event-driven workflows, n8n / Make / Zapier, and downstream actions tied to system truth.',
  },
  {
    title: 'Applied AI inside operations',
    body: 'Summaries, routing, synthesis, and engineering support workflows grounded in real system context.',
  },
];
---

<SiteLayout
  title="Jariel Balberona | Senior Software Engineer and AI Automation Engineer"
  description="Jariel Balberona builds production-grade systems, event-driven workflows, automation infrastructure, and AI-assisted operational tools."
  activeNav="home"
>
  <section class="mb-16">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Senior software engineer and AI automation engineer</p>
    <h1 class="max-w-[14ch] text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-tight">
      I build production systems, backend workflows, and applied AI tooling that hold up in real operations.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      I work across product engineering, backend systems, architecture, infrastructure, workflow automation, and AI-assisted tooling. The throughline is simple: make the system clearer, more reliable, and easier to operate under real conditions.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/work" class="inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft transition-colors">See work</a>
      <a href="/ai-automation" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">AI automation</a>
      <a href="/workflow" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Read my workflow</a>
    </div>
  </section>

  <section class="mb-16 border-t border-line pt-8">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Proof bar</p>
    <div class="grid gap-4 md:grid-cols-2">
      {proofBar.map((item) => (
        <article class="border border-line p-4">
          <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">{item.label}</p>
          <h2 class="mt-2 text-lg font-semibold tracking-tight text-ink">{item.value}</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mb-16 border-t border-line pt-8">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Current work</p>
    <h2 class="max-w-2xl text-2xl font-semibold tracking-tight text-ink">Dumadine is a hospitality operating system built around live service, stock movement, and downstream automation.</h2>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-soft">
      Dumadine connects ordering, kitchen flow, inventory movement, accounting behavior, and operator visibility in one system. That matters because automation, reporting, and AI support are only credible when they attach to coherent operational truth.
    </p>
    <ul class="mt-6 max-w-3xl space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
      <li>Multi-tenant product architecture across ordering, kitchen, stock, and venue management flows.</li>
      <li>Backend and data design that preserve domain boundaries while supporting real-time coordination.</li>
      <li>System shape built to support reporting, operational summaries, and downstream automation from actual product state.</li>
    </ul>
    <div class="mt-6 flex flex-wrap gap-4">
      <a href={`/work/${featuredWork.id.replace(/\.md$/, '')}`} class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Read Dumadine</a>
      {featuredWork.data.liveUrl && (
        <a href={featuredWork.data.liveUrl} class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Visit live site</a>
      )}
    </div>
  </section>

  <ToolingStack />

  <section class="mb-16 grid gap-8 md:grid-cols-2">
    {focusAreas.map((item) => (
      <article class="border-t border-line pt-5">
        <p class="text-xs font-mono uppercase tracking-widest text-ink-soft">{item.title}</p>
        <p class="mt-3 text-sm leading-relaxed text-ink">{item.body}</p>
      </article>
    ))}
  </section>

  <section class="grid gap-12 md:grid-cols-2">
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Automation and AI</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">AI and automation show up here as working systems, engineering acceleration, and operational support.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        The important split is between internal engineering leverage and shipped product workflows. Both matter, but they are not the same thing, and I treat them differently.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/ai-automation" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">See AI automation</a>
      </div>
    </article>

    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Explore</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">The rest of the site goes deeper into shipped work, operating patterns, and how I use AI in engineering.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        Each page covers a specific slice of the work: production systems, automation patterns, delivery discipline, and current priorities.
      </p>
      <ul class="mt-6 divide-y divide-line text-sm leading-relaxed text-ink">
        <li class="py-3"><strong class="font-medium text-ink">AI Automation:</strong> production automation, orchestration patterns, and AI support tied to real system state</li>
        <li class="py-3"><strong class="font-medium text-ink">Work:</strong> product and platform projects, ownership, constraints, and outcomes</li>
        <li class="py-3"><strong class="font-medium text-ink">Workflow:</strong> how I scope, execute, verify, and keep AI-assisted work controlled</li>
      </ul>
    </article>
  </section>
</SiteLayout>
