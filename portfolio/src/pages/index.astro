---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const [featuredWork] = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((entry) => entry.data.featured);

const featuredStrengths = [
  {
    title: 'Maintainable architecture',
    body: 'Designing system boundaries that stay understandable, testable, and changeable as features, teams, and operational load increase.',
  },
  {
    title: 'Scalable frontend systems',
    body: 'Building React and TypeScript applications with disciplined state, data, and UI structure so feature work does not turn into churn.',
  },
  {
    title: 'Backend reliability',
    body: 'Building APIs, data flows, and operational workflows with reliability, failure recovery, and observability built in from the start.',
  },
  {
    title: 'End-to-end delivery',
    body: 'Shipping across frontend, backend, infrastructure, and CI/CD so the system holds together beyond the component layer.',
  },
];

const signalCards = [
  {
    kicker: 'Current work',
    title: featuredWork.data.title,
    body: featuredWork.data.summary,
  },
  {
    kicker: 'Engineering stance',
    title: 'System health drives product velocity',
    body: 'Maintainability, reliability, and delivery discipline are not cleanup work. They determine how fast a product can keep shipping without degrading.',
  },
  {
    kicker: 'AI usage',
    title: 'Used as leverage',
    body: 'I use AI for drafting, synthesis, review support, and refactoring acceleration. Architecture, tradeoffs, and production responsibility stay with me.',
  },
];
---

<SiteLayout
  title="Jariel Balberona | Product Engineering, Architecture, Delivery"
  description="Jariel Balberona builds production systems across frontend, backend, and infrastructure with a focus on maintainability, scalability, reliability, and delivery."
  activeNav="home"
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Senior software engineer</p>
    <h1 class="max-w-[14ch] text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-tight">
      I build production systems that keep working as complexity grows.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      I work across frontend, backend, data, and delivery systems with a bias toward clear architecture, reliable operation, and codebases that stay changeable over time.
    </p>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink">
      Current focus is Dumadine, a multi-tenant hospitality system covering ordering, kitchen flow, inventory, and accounting workflows shaped against live operations instead of demo assumptions.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/work" class="inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft transition-colors">See selected work</a>
      <a href="/workflow" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Read my workflow</a>
    </div>
    <p class="mt-8 max-w-2xl text-sm leading-relaxed text-ink-soft">
      Strongest signal: React and TypeScript applications, Node.js APIs, PostgreSQL-backed products, and delivery systems structured to keep moving under ongoing product pressure.
    </p>
  </section>

  <section class="mb-20 grid gap-8 md:grid-cols-3">
    {
      signalCards.map((card) => (
        <article class="border-t border-line pt-5">
          <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">{card.kicker}</p>
          <h2 class="text-xl font-semibold tracking-tight text-ink">{card.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{card.body}</p>
        </article>
      ))
    }
  </section>

  <section class="mb-20 border-t border-line pt-10">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Where I am strongest</p>
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight text-ink leading-tight">The hard part is not shipping once. It is keeping the system workable after the first push.</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-2 md:gap-12">
      {
        featuredStrengths.map((item) => (
          <div>
            <h3 class="text-xl font-semibold tracking-tight text-ink">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="grid gap-12 md:grid-cols-2">
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Selected proof</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Selected work with enough shape to evaluate.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        I would rather show a smaller set of work with clear scope, constraints, and technical decisions than a long list of thin project summaries.
      </p>
      <ul class="mt-5 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
        {featuredWork.data.highlights.map((item) => <li>{item}</li>)}
      </ul>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={`/work/${featuredWork.id.replace(/\.md$/, '')}`} class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Read project details</a>
        {featuredWork.data.liveUrl && (
          <a href={featuredWork.data.liveUrl} class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Visit live site</a>
        )}
      </div>
    </article>

    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">What you will find here</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Current work, selected proof, and engineering approach.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        The point of this site is simple: show what I am building, how I think about systems, and where the engineering work has real operational shape.
      </p>
      <ul class="mt-6 divide-y divide-line text-sm leading-relaxed text-ink">
        <li class="py-3"><strong class="font-medium text-ink">Now:</strong> what I am actively building and tightening</li>
        <li class="py-3"><strong class="font-medium text-ink">Work:</strong> projects with enough detail to judge scope and execution</li>
        <li class="py-3"><strong class="font-medium text-ink">Workflow:</strong> how I plan, build, review, and use AI as support rather than a substitute</li>
      </ul>
    </article>
  </section>
</SiteLayout>
