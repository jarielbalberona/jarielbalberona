---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const [featuredWork] = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((entry) => entry.data.featured);

const featuredStrengths = [
  {
    title: 'Maintainable architecture',
    body: 'Designing frontend and backend boundaries that stay understandable, testable, and changeable as the product grows.',
  },
  {
    title: 'Scalable frontend systems',
    body: 'Building React and TypeScript systems with strong state, data, and UI structure instead of letting feature work turn into entropy.',
  },
  {
    title: 'Backend reliability',
    body: 'Building APIs, data flows, and operational workflows with reliability, performance, and recovery in mind.',
  },
  {
    title: 'End-to-end delivery',
    body: 'Shipping across frontend, backend, infrastructure, and CI/CD so delivery quality does not stop at the component layer.',
  },
];

const signalCards = [
  {
    kicker: 'Current work',
    title: featuredWork.data.title,
    body: featuredWork.data.summary,
  },
  {
    kicker: 'Engineering stance',
    title: 'System health is product work',
    body: 'Maintainability, reliability, and delivery structure are not cleanup tasks. They decide how fast a product can keep moving after the first release.',
  },
  {
    kicker: 'AI usage',
    title: 'Leverage, not theater',
    body: 'I use AI for planning, synthesis, review support, and refactoring acceleration. System design, tradeoffs, and production responsibility stay with me.',
  },
];
---

<SiteLayout
  title="Jariel Balberona | Product Engineering, Architecture, Delivery"
  description="Jariel Balberona builds production systems across frontend, backend, and infrastructure with a focus on maintainability, scalability, reliability, and delivery."
  activeNav="home"
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Senior software engineer</p>
    <h1 class="max-w-[14ch] text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-tight">
      I build production systems that stay maintainable under growth.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Senior engineer spanning frontend, backend, and infrastructure. I build systems that perform reliably in production and remain maintainable as they scale.
    </p>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink">
      Currently building Dumadine, a multi-tenant cafe operating system. The standard is consistent across my work: clear architecture, operational reality, and predictable delivery without the startup theater.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/work" class="inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft transition-colors">See selected work</a>
      <a href="/workflow" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Read my workflow</a>
    </div>
    <p class="mt-8 max-w-2xl text-sm leading-relaxed text-ink-soft">
      Strongest signal: React and TypeScript systems, Node.js APIs, PostgreSQL-backed products, infrastructure-aware
      delivery, and codebases built to keep moving as they grow.
    </p>
  </section>

  <section class="mb-20 grid gap-8 md:grid-cols-3">
    {
      signalCards.map((card) => (
        <article class="border-t border-line pt-5">
          <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">{card.kicker}</p>
          <h2 class="text-xl font-semibold tracking-tight text-ink">{card.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{card.body}</p>
        </article>
      ))
    }
  </section>

  <section class="mb-20 border-t border-line pt-10">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Where I am strongest</p>
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight text-ink leading-tight">The actual challenge is keeping systems changeable under growth.</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-2 md:gap-12">
      {
        featuredStrengths.map((item) => (
          <div>
            <h3 class="text-xl font-semibold tracking-tight text-ink">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="grid gap-12 md:grid-cols-2">
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Selected proof</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Selected work should survive technical scrutiny.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        This section stays curated deliberately. Scope, constraints, architecture, and operational tradeoffs matter more than an inflated project list.
      </p>
      <ul class="mt-5 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
        {featuredWork.data.highlights.map((item) => <li>{item}</li>)}
      </ul>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={`/work/${featuredWork.id.replace(/\.md$/, '')}`} class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Read project details</a>
        {featuredWork.data.liveUrl && (
          <a href={featuredWork.data.liveUrl} class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Visit live site</a>
        )}
      </div>
    </article>

    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">What belongs here</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">This site is a professional surface, not a brand exercise.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        It is here to show current direction, project proof, and engineering judgment. It is not here to act like a
        scrapbook, a funnel, or an AI mascot.
      </p>
      <ul class="mt-6 divide-y divide-line text-sm leading-relaxed text-ink">
        <li class="py-3"><strong class="font-medium text-ink">Current:</strong> what I am actively building and improving</li>
        <li class="py-3"><strong class="font-medium text-ink">Work:</strong> public proof with scope, constraints, and technical shape</li>
        <li class="py-3"><strong class="font-medium text-ink">Workflow:</strong> how I plan, build, review, and use AI without outsourcing judgment</li>
      </ul>
    </article>
  </section>
</SiteLayout>
