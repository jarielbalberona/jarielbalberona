---
import { getCollection } from 'astro:content';
import ToolingStack from '../components/ToolingStack.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const [featuredWork] = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((entry) => entry.data.featured);

const featuredStrengths = [
  'Backend systems and architecture',
  'Production reliability',
  'Event-driven workflows',
  'Workflow orchestration',
  'Applied AI systems',
];
---

<SiteLayout
  title="Jariel Balberona | Senior Software Engineer and AI Automation Engineer"
  description="Jariel Balberona builds production-grade systems, event-driven workflows, automation infrastructure, and AI-assisted operational tools."
  activeNav="home"
>
  <section class="mb-16">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Senior software engineer and AI automation engineer</p>
    <h1 class="max-w-[14ch] text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-tight">
      I build production-grade systems, event-driven workflows, and AI-assisted operational tools.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      I design backend systems, APIs, and data flows that hold up under real operational pressure, then extend them with automation and AI to reduce manual work and improve system clarity.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/work" class="inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft transition-colors">See selected work</a>
      <a href="/ai-automation" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">AI automation</a>
      <a href="/workflow" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Read my workflow</a>
    </div>
  </section>

  <section class="mb-16 border-t border-line pt-8">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Focus</p>
    <ul class="grid gap-3 text-sm leading-relaxed text-ink md:grid-cols-2">
      {featuredStrengths.map((item) => <li class="border-t border-line pt-3">{item}</li>)}
    </ul>
  </section>

  <section class="mb-16 border-t border-line pt-8">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Dumadine</p>
    <h2 class="max-w-2xl text-2xl font-semibold tracking-tight text-ink">A hospitality operating system designed around live service conditions, not isolated feature screens.</h2>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-soft">
      It connects ordering, kitchen operations, inventory, and accounting into one operational flow, then creates room for automation, reporting, and AI-assisted support on top of real system state.
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <a href={`/work/${featuredWork.id.replace(/\.md$/, '')}`} class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Read Dumadine</a>
      {featuredWork.data.liveUrl && (
        <a href={featuredWork.data.liveUrl} class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">Visit live site</a>
      )}
    </div>
  </section>

  <ToolingStack />

  <section class="grid gap-12 md:grid-cols-2">
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Automation and AI</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">I use automation and AI to extend real systems, not decorate them.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        That means event-driven workflows, orchestration across APIs and tools, and AI-assisted summaries, classification, and decision support tied to live operational data.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/ai-automation" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink hover:text-ink transition-colors">See AI automation</a>
      </div>
    </article>

    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Deeper pages</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Use the front page for signal. Use the deeper pages for proof.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        The homepage should establish identity fast. The detailed thinking lives on the pages below.
      </p>
      <ul class="mt-6 divide-y divide-line text-sm leading-relaxed text-ink">
        <li class="py-3"><strong class="font-medium text-ink">AI Automation:</strong> how I apply automation and AI inside real systems</li>
        <li class="py-3"><strong class="font-medium text-ink">Work:</strong> selected projects with real constraints and system decisions</li>
        <li class="py-3"><strong class="font-medium text-ink">Workflow:</strong> how I structure engineering, automation, and AI without losing control of the system</li>
      </ul>
    </article>
  </section>
</SiteLayout>
