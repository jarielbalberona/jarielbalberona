---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatNoteDate, isPublishedNote, noteUrl, readingTime, sortNotesNewestFirst } from '../lib/notes';

const [ordrNow] = (await getCollection('work'))
  .filter((entry) => entry.id === 'ordr-now')
  .sort((a, b) => a.data.order - b.data.order);
const [latestNote] = (await getCollection('notes')).filter(isPublishedNote).sort(sortNotesNewestFirst);

const foundations = [
  'TypeScript',
  'React and Next.js',
  'Node.js',
  'PostgreSQL',
  'Multi-tenant SaaS',
  'Offline-first systems',
  'AWS and Azure',
  'Automated QA',
  'Observability',
  'Production delivery',
];
---

<SiteLayout
  title="Jariel Balberona | Staff-Level AI-Native Software Engineer"
  description="Staff-level software engineer specializing in AI-native product development, agentic engineering systems, and governed autonomous software delivery."
  activeNav="home"
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Staff-Level AI-Native Software Engineer</p>
    <h1 class="max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
      I design and ship production platforms end to end, with a focus on governed agentic engineering systems.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      I translate product intent into implemented, verified, and deployed software. The work combines 10+ years of conventional product and platform engineering with structured agent execution, closed-loop verification, and explicit human accountability.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/work" class="inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft">See the work</a>
      <a href="/ai-native-engineering" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink">How I engineer with AI</a>
    </div>
  </section>

  <section class="mb-20 border-t border-line pt-8" aria-labelledby="scope-heading">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Engineering scope</p>
    <h2 id="scope-heading" class="max-w-2xl text-2xl font-semibold leading-tight tracking-tight text-ink">
      Product ownership, platform architecture, and delivery discipline in one hands-on engineering role.
    </h2>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      <article class="border-t border-line pt-4">
        <h3 class="text-base font-semibold text-ink">End-to-end ownership</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">Product definition, architecture, frontend, backend, data, cloud delivery, and production verification.</p>
      </article>
      <article class="border-t border-line pt-4">
        <h3 class="text-base font-semibold text-ink">Agentic engineering systems</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">Repository-grounded agents that investigate, implement, verify, retry within bounds, and escalate when judgment is required.</p>
      </article>
      <article class="border-t border-line pt-4">
        <h3 class="text-base font-semibold text-ink">Production foundations</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">Strong full-stack, multi-tenant, offline-first, cloud, testing, observability, and release-engineering practice.</p>
      </article>
    </div>
  </section>

  {ordrNow && (
    <section class="mb-20 border-t border-line pt-8" aria-labelledby="ordr-heading">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Anchor case study</p>
      <h2 id="ordr-heading" class="max-w-2xl text-3xl font-semibold leading-tight tracking-tight text-ink">Ordr.now</h2>
      <p class="mt-2 text-sm font-medium text-ink">Founder & CTO | Staff AI-Native Software Engineer</p>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft">
        A multi-tenant hospitality platform spanning offline-first point of sale, ordering, kitchen operations, inventory, synchronization, and cloud delivery. I own the product and technical system end to end.
      </p>
      <div class="mt-7 flex flex-wrap gap-4">
        <a href="/work/ordr-now" class="inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft">Read the Ordr.now case study</a>
        {ordrNow.data.liveUrl && <a href={ordrNow.data.liveUrl} data-analytics-event="ordr_now_click" data-analytics-location="home_anchor_case" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink">Visit Ordr.now</a>}
      </div>
    </section>
  )}

  <section class="mb-20 border-t border-line pt-8" aria-labelledby="foundation-heading">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Technical foundation</p>
    <h2 id="foundation-heading" class="max-w-2xl text-2xl font-semibold leading-tight tracking-tight text-ink">
      AI-native delivery is credible only when the underlying software engineering is strong.
    </h2>
    <ul class="mt-7 flex max-w-3xl flex-wrap gap-2 text-sm text-ink">
      {foundations.map((item) => <li class="border border-line px-3 py-1.5">{item}</li>)}
    </ul>
  </section>

  {latestNote && (
    <section class="mb-20 border-t border-line pt-8" aria-labelledby="latest-note-heading">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Latest note</p>
      <h2 id="latest-note-heading" class="max-w-2xl text-2xl font-semibold leading-tight tracking-tight text-ink">{latestNote.data.title}</h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-soft">{latestNote.data.summary}</p>
      <div class="mt-4 flex flex-wrap gap-3 text-xs text-ink-soft">
        <time datetime={latestNote.data.publishedDate.toISOString()}>{formatNoteDate(latestNote.data.publishedDate)}</time>
        <span>{readingTime(latestNote.body ?? '').label}</span>
      </div>
      <a href={noteUrl(latestNote)} data-analytics-event="article_open" data-analytics-location="home_latest_note" class="mt-6 inline-flex text-sm font-semibold text-ink underline decoration-line underline-offset-4 hover:decoration-ink">Read the note</a>
    </section>
  )}

  <section class="grid gap-10 border-t border-line pt-8 md:grid-cols-2">
    <div>
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">AI-native engineering</p>
      <h2 class="text-2xl font-semibold leading-tight tracking-tight text-ink">Governed autonomy, not unrestricted automation.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">Deterministic systems where correctness is required, AI where interpretation adds value, and humans where judgment and accountability remain necessary.</p>
      <a href="/ai-native-engineering" class="mt-6 inline-flex text-sm font-semibold text-ink underline decoration-line underline-offset-4 hover:decoration-ink">Read the operating model</a>
    </div>
    <div>
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Availability</p>
      <h2 class="text-2xl font-semibold leading-tight tracking-tight text-ink">Staff-level roles and selective consulting.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">Open to staff-level AI-native product engineering and platform engineering roles, as well as selective consulting engagements.</p>
      <a href="/contact" class="mt-6 inline-flex text-sm font-semibold text-ink underline decoration-line underline-offset-4 hover:decoration-ink">Start a conversation</a>
    </div>
  </section>
</SiteLayout>
