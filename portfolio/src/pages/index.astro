---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatNoteDate, isPublishedNote, noteUrl, readingTime, sortNotesNewestFirst } from '../lib/notes';

const [ordrNow] = (await getCollection('work')).filter((entry) => entry.id === 'ordr-now');
const latestNotes = (await getCollection('notes')).filter(isPublishedNote).sort(sortNotesNewestFirst).slice(0, 3);

const practice = [
  {
    title: 'End-to-end ownership',
    body: 'Product definition, architecture, frontend, backend, data, cloud delivery, and production verification.',
  },
  {
    title: 'Agentic engineering systems',
    body: 'Repository-grounded agents that investigate, implement, verify, retry within bounds, and escalate when judgment is required.',
  },
  {
    title: 'Production foundations',
    body: 'TypeScript, React and Next.js, Node.js, PostgreSQL, multi-tenant SaaS, offline-first systems, AWS and Azure, automated QA, and observability.',
  },
];
---

<SiteLayout
  title="Jariel Balberona | Staff-Level AI-Native Software Engineer"
  description="Staff-level software engineer specializing in AI-native product development, agentic engineering systems, and governed autonomous software delivery."
  activeNav="home"
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Staff-Level AI-Native Software Engineer</p>
    <h1 class="max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
      I design and ship production platforms end to end, with a focus on governed agentic engineering systems.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      I translate product intent into implemented, verified, and deployed software. The work combines 10+ years of conventional product and platform engineering with structured agent execution, closed-loop verification, and explicit human accountability.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/work" class="inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft">See the work</a>
      <a href="/ai-native-engineering" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink">How I engineer with AI</a>
    </div>
  </section>

  {ordrNow && (
    <section class="mb-20 border-t border-line pt-8" aria-labelledby="ordr-heading">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">The product I build</p>
      <h2 id="ordr-heading" class="max-w-2xl text-3xl font-semibold leading-tight tracking-tight text-ink">Ordr.now</h2>
      <p class="mt-2 text-sm font-medium text-ink">Founder & CTO</p>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft">
        A multi-tenant hospitality platform spanning offline-first point of sale, ordering, kitchen operations, inventory, synchronization, and cloud delivery. I own the product and technical system end to end.
      </p>
      <div class="mt-7 flex flex-wrap gap-4">
        <a href="/work/ordr-now" class="inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft">Read the case study</a>
        {ordrNow.data.liveUrl && <a href={ordrNow.data.liveUrl} data-analytics-event="ordr_now_click" data-analytics-location="home_anchor_case" class="inline-flex border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:border-ink">Visit Ordr.now</a>}
      </div>
    </section>
  )}

  <section class="mb-20 border-t border-line pt-8" aria-labelledby="practice-heading">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">What I do</p>
    <h2 id="practice-heading" class="max-w-2xl text-2xl font-semibold leading-tight tracking-tight text-ink">
      AI-native delivery is credible only when the underlying software engineering is strong.
    </h2>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      {practice.map((item) => (
        <article class="border-t border-line pt-4">
          <h3 class="text-base font-semibold text-ink">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  {latestNotes.length > 0 && (
    <section class="mb-20 border-t border-line pt-8" aria-labelledby="notes-heading">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Writing</p>
      <h2 id="notes-heading" class="max-w-2xl text-2xl font-semibold leading-tight tracking-tight text-ink">Latest notes</h2>
      <ol class="mt-6 space-y-6">
        {latestNotes.map((entry) => (
          <li class="border-t border-line pt-4">
            <h3 class="text-lg font-semibold tracking-tight text-ink">
              <a href={noteUrl(entry)} data-analytics-event="article_open" data-analytics-location="home_latest_note" class="underline decoration-line underline-offset-4 hover:decoration-ink">{entry.data.title}</a>
            </h3>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-soft">{entry.data.summary}</p>
            <div class="mt-3 flex flex-wrap gap-3 text-xs text-ink-soft">
              <time datetime={entry.data.publishedDate.toISOString()}>{formatNoteDate(entry.data.publishedDate)}</time>
              <span>{readingTime(entry.body ?? '').label}</span>
            </div>
          </li>
        ))}
      </ol>
      <a href="/notes" class="mt-6 inline-flex text-sm font-semibold text-ink underline decoration-line underline-offset-4 hover:decoration-ink">All notes</a>
    </section>
  )}

  <section class="border-t border-line pt-8" aria-labelledby="contact-heading">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Availability</p>
    <h2 id="contact-heading" class="max-w-2xl text-2xl font-semibold leading-tight tracking-tight text-ink">Staff-level roles and selective consulting.</h2>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-soft">Open to staff-level AI-native product engineering and platform engineering roles, as well as selective consulting engagements.</p>
    <a href="/contact" class="mt-6 inline-flex text-sm font-semibold text-ink underline decoration-line underline-offset-4 hover:decoration-ink">Start a conversation</a>
  </section>
</SiteLayout>
