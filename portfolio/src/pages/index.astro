---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const [featuredWork] = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((entry) => entry.data.featured);

const featuredStrengths = [
  {
    title: 'Maintainable architecture',
    body: 'Designing frontend and backend boundaries that stay understandable, testable, and changeable as the product grows.',
  },
  {
    title: 'Scalable frontend systems',
    body: 'Building React and TypeScript systems with strong state, data, and UI structure instead of letting feature work turn into entropy.',
  },
  {
    title: 'Backend reliability',
    body: 'Building APIs, data flows, and operational workflows with reliability, performance, and recovery in mind.',
  },
  {
    title: 'End-to-end delivery',
    body: 'Shipping across frontend, backend, infrastructure, and CI/CD so delivery quality does not stop at the component layer.',
  },
];

const signalCards = [
  {
    kicker: 'Current work',
    title: featuredWork.data.title,
    body: featuredWork.data.summary,
  },
  {
    kicker: 'Engineering stance',
    title: 'System health is product work',
    body: 'Maintainability, reliability, and delivery structure are not cleanup tasks. They decide how fast a product can keep moving after the first release.',
  },
  {
    kicker: 'AI usage',
    title: 'Leverage, not theater',
    body: 'I use AI for planning, synthesis, review support, and refactoring acceleration. System design, tradeoffs, and production responsibility stay with me.',
  },
];
---

<SiteLayout
  title="Jariel Balberona | Product Engineering, Architecture, Delivery"
  description="Jariel Balberona builds production systems across frontend, backend, and infrastructure with a focus on maintainability, scalability, reliability, and delivery."
  activeNav="home"
>
  <section class="mb-9">
    <div class="border border-line bg-paper-panel/95 p-8 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
      <div class="mb-4 inline-flex rounded-full bg-moss px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent-strong">
        Senior software engineer
      </div>
      <h1 class="max-w-[12ch] font-display text-5xl leading-[0.95] font-semibold tracking-[-0.04em] text-ink sm:text-7xl">
        I build production systems that stay maintainable under growth.
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-ink-soft">
        Senior fullstack and product engineer working across frontend, backend, and infrastructure. I focus on
        maintainability, scalability, performance, reliability, and predictable delivery.
      </p>
      <p class="mt-4 max-w-3xl text-base leading-8 text-ink">
        Right now that means Dumadine, a multi-tenant cafe operating system, and a tighter public surface around the
        actual work. The standard is the same in both: clear system design, operational reality, and no portfolio
        filler.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/work" class="rounded-full bg-accent-strong px-5 py-3 text-sm font-semibold text-paper-panel no-underline">See selected work</a>
        <a href="/workflow" class="rounded-full border border-line px-5 py-3 text-sm font-semibold text-ink no-underline hover:bg-ink hover:text-paper-panel">Read my workflow</a>
      </div>
      <p class="mt-5 text-sm text-ink-soft">
        Strongest signal: React and TypeScript systems, Node.js APIs, PostgreSQL-backed products, infrastructure-aware
        delivery, and codebases built to keep moving as they grow.
      </p>
    </div>
  </section>

  <section class="mb-9 grid gap-4 md:grid-cols-3">
    {
      signalCards.map((card) => (
        <article class="border border-line bg-paper-panel/90 p-5 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">{card.kicker}</p>
          <h2 class="font-display text-2xl leading-tight text-ink">{card.title}</h2>
          <p class="mt-3 text-sm leading-7 text-ink-soft">{card.body}</p>
        </article>
      ))
    }
  </section>

  <section class="mb-9 border border-line bg-paper-panel/90 p-6 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">Where I am strongest</p>
    <h2 class="font-display text-4xl leading-tight text-ink">The hard part is keeping systems changeable under growth.</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-2">
      {
        featuredStrengths.map((item) => (
          <div>
            <h3 class="font-display text-2xl text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-7 text-ink-soft">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="grid gap-5 md:grid-cols-2">
    <article class="border border-line bg-paper-panel/90 p-6 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">Selected proof</p>
      <h2 class="font-display text-4xl leading-tight text-ink">Selected work should survive technical scrutiny.</h2>
      <p class="mt-4 text-sm leading-7 text-ink-soft">
        The work section stays curated on purpose. Scope, constraints, architecture, and operational tradeoffs matter
        more than an inflated project count.
      </p>
      <ul class="mt-4 space-y-3 pl-5 text-sm leading-7 text-ink">
        {featuredWork.data.highlights.map((item) => <li>{item}</li>)}
      </ul>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`/work/${featuredWork.id.replace(/\.md$/, '')}`} class="rounded-full border border-line px-5 py-3 text-sm font-semibold text-ink no-underline hover:bg-ink hover:text-paper-panel">Read project details</a>
        {featuredWork.data.liveUrl && (
          <a href={featuredWork.data.liveUrl} class="rounded-full border border-line px-5 py-3 text-sm font-semibold text-ink no-underline hover:bg-ink hover:text-paper-panel">Visit live site</a>
        )}
      </div>
    </article>

    <article class="border border-line bg-paper-panel/90 p-6 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">What belongs here</p>
      <h2 class="font-display text-4xl leading-tight text-ink">This site is a professional surface, not a brand exercise.</h2>
      <p class="mt-4 text-sm leading-7 text-ink-soft">
        It is here to show current direction, project proof, and engineering judgment. It is not here to act like a
        scrapbook, a funnel, or an AI mascot.
      </p>
      <ul class="mt-5 divide-y divide-line text-sm leading-7 text-ink">
        <li class="py-3"><strong>Current:</strong> what I am actively building and improving</li>
        <li class="py-3"><strong>Work:</strong> public proof with scope, constraints, and technical shape</li>
        <li class="py-3"><strong>Workflow:</strong> how I plan, build, review, and use AI without outsourcing judgment</li>
      </ul>
    </article>
  </section>
</SiteLayout>
