---
import SiteLayout from '../layouts/SiteLayout.astro';

const phases = [
  {
    kicker: '1. Intake and inspection',
    title: 'Read the actual system before touching it',
    body: 'I start by inspecting the existing code, ticket context, current behavior, and likely failure paths. Most engineering waste starts with people editing against assumptions.',
    points: [
      'what already exists and what the system is really doing',
      'what the issue actually is, not what the ticket vaguely implies',
      'what the blast radius is and what should stay untouched',
      'what verification will be needed before any change is called done',
    ],
    outro: 'Moving fast without inspecting reality is not speed. It is churn.',
  },
  {
    kicker: '2. Scope the work',
    title: 'Turn loose requests into ticket-scoped execution',
    body: 'Before implementation, I reduce ambiguity, define boundaries, and make the unit of work concrete enough to execute without thrashing.',
    points: [
      'clear scope instead of vague cleanup language',
      'explicit acceptance criteria or at least verifiable intent',
      'known constraints, dependencies, and risks',
      'a decision on whether the task is code, automation, infra, or cross-cutting work',
    ],
  },
  {
    kicker: '3. Isolate execution',
    title: 'One ticket, one branch or worktree, one blast radius',
    body: 'I prefer isolated branches or worktrees for ticket-scoped work so overlapping changes do not pollute each other. That matters even more when AI is helping with exploration or drafting.',
    points: [
      'separate execution context for each meaningful task',
      'cleaner reviews and less cross-ticket contamination',
      'traceable progress when switching between product, infra, and automation work',
    ],
    outro: 'AI support is useful here because the structure is already disciplined.',
  },
  {
    kicker: '4. Use AI where it is actually useful',
    title: 'Exploration, drafting, synthesis, review support',
    body: 'I use AI heavily, but in bounded ways that map cleanly to engineering work instead of replacing it.',
    points: [
      'codebase exploration and pattern discovery',
      'drafting implementation on well-scoped tasks',
      'synthesizing tickets, notes, and code context into execution plans',
      'review support for dead code, drift, and obvious failure modes',
    ],
    outro: 'The ownership never moves. The assistance just removes drag.',
  },
  {
    kicker: '5. Verify before calling it done',
    title: 'Verification is part of implementation',
    body: 'I treat verification as a first-class engineering step, not a courtesy after code lands.',
    points: [
      'check the current behavior first',
      'implement narrowly and verify locally',
      'run the relevant tests, type checks, or runtime checks',
      'review the final shape for maintainability, not just task completion',
    ],
    outro: 'A change is done when it survives scrutiny, not when a diff exists.',
  },
];

const operatingModel = [
  'Tickets or scoped requests become bounded execution units before implementation starts.',
  'Branches or worktrees isolate changes so context switching does not corrupt active work.',
  'AI helps with exploration, drafting, synthesis, and review, but not with final authority.',
  'Verification happens before and after changes through tests, type checks, runtime review, and manual inspection when needed.',
  'Ownership stays with me across tradeoffs, code quality, release confidence, and whether the work should ship at all.',
];

const workflowTooling = [
  {
    title: 'Planning and execution',
    items: ['Linear', 'ticket-scoped tasks', 'worktrees', 'git branches'],
  },
  {
    title: 'Implementation',
    items: ['TypeScript', 'Node.js', 'React', 'Astro', 'backend and infra code'],
  },
  {
    title: 'AI assistance',
    items: ['Codex', 'Cursor', 'ChatGPT', 'drafting', 'synthesis', 'review support'],
  },
  {
    title: 'Verification and delivery',
    items: ['tests', 'type checks', 'GitHub Actions', 'manual runtime verification'],
  },
];
---

<SiteLayout
  title="Workflow | Jariel Balberona"
  description="How Jariel Balberona approaches planning, implementation, review, automation systems, and disciplined AI-assisted engineering work."
  activeNav="workflow"
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Workflow</p>
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-ink leading-tight">
      How I keep engineering work scoped, testable, and shippable.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      I use AI heavily in engineering work, but the workflow is still built around scope, isolation, verification, and ownership. That is what keeps acceleration from turning into noise.
    </p>
  </section>

  <section class="mb-20 grid gap-8 md:grid-cols-2">
    {
      phases.map((phase) => (
        <article class="border-t border-line pt-5">
          <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">{phase.kicker}</p>
          <h2 class="text-xl font-semibold tracking-tight text-ink">{phase.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{phase.body}</p>
          {phase.points && (
            <ul class="mt-5 space-y-2 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
              {phase.points.map((item) => <li>{item}</li>)}
            </ul>
          )}
          {phase.outro && <p class="mt-5 text-sm leading-relaxed text-ink-soft">{phase.outro}</p>}
        </article>
      ))
    }
  </section>

  <section class="mb-24 grid gap-12 md:grid-cols-2">
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Operating model</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">What this workflow optimizes for</h2>
      <ul class="mt-5 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
        {operatingModel.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Tooling I actually use</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">The tooling supports the work. The standard is disciplined execution.</h2>
      <div class="mt-6 space-y-6">
        {workflowTooling.map((group) => (
          <div class="border-t border-line pt-4">
            <h3 class="text-base font-semibold tracking-tight text-ink">{group.title}</h3>
            <ul class="mt-3 flex flex-wrap gap-2 text-sm leading-relaxed text-ink">
              {group.items.map((item) => <li class="border border-line px-2.5 py-1">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </article>
  </section>

  <section class="border-t border-line pt-10">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Engineering standard</p>
    <h2 class="text-2xl font-semibold tracking-tight text-ink">Weak structure creates most of the avoidable pain.</h2>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      Most delivery problems show up long before production. Scope stays vague. Changes overlap. Verification gets postponed. Then the codebase starts fighting back.
    </p>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      My workflow is built to cut that failure pattern early: inspect first, scope the work, isolate it, use AI where it removes friction, and verify before calling it done.
    </p>
  </section>
</SiteLayout>
