---
import SiteLayout from '../layouts/SiteLayout.astro';

const phases = [
  {
    kicker: '1. Assess',
    title: 'Inspect before changing',
    body: 'I start by reading the existing system, constraints, and failure modes. Fast guesses are cheap. Cleaning up after them is not.',
  },
  {
    kicker: '2. Shape',
    title: 'Reduce ambiguity early',
    body: 'I define the problem, tighten the scope, and call out tradeoffs before implementation drifts into vague motion.',
  },
  {
    kicker: '3. Build',
    title: 'Prefer structure that survives',
    body: 'I favor maintainable boundaries, clear ownership, and delivery patterns that can keep moving without turning the codebase into a negotiation.',
  },
  {
    kicker: '4. Review',
    title: 'Correctness is not delegated',
    body: 'Changes still need technical scrutiny, product judgment, and operational thinking. Shipping faster only matters if the result still deserves to exist.',
  },
];

const aiHelps = [
  'Shaping options when a problem space is still broad',
  'Drafting implementation paths and reducing startup drag',
  'Refactoring support, codebase exploration, and repetitive scaffolding',
  'Synthesis across docs, code, and open decisions',
  'Review support for consistency checks and obvious gaps',
];

const engineerOwns = [
  'Architecture and system boundaries',
  'Product tradeoffs and implementation judgment',
  'Correctness and review quality',
  'Production accountability',
  'Deciding what not to build',
];
---

<SiteLayout
  title="Workflow | Jariel Balberona"
  description="How Jariel Balberona approaches architecture, maintainability, delivery, and AI-assisted engineering work."
  activeNav="workflow"
  footerLeft="Planning, implementation, review"
  footerRight="AI is useful. Judgment still matters more."
>
  <section class="mb-9 border border-line bg-paper-panel/95 p-8 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
    <div class="mb-4 inline-flex rounded-full bg-moss px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent-strong">
      Workflow
    </div>
    <h1 class="font-display text-5xl leading-[0.98] tracking-[-0.04em] text-ink sm:text-7xl">
      Use AI where it helps. Keep engineering ownership.
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-ink-soft">
      I use AI for planning, synthesis, review support, and implementation acceleration. I do not use it as a
      substitute for architecture, product reasoning, review quality, or production ownership.
    </p>
  </section>

  <section class="mb-9 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {
      phases.map((phase) => (
        <article class="border border-line bg-paper-panel/90 p-5 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">{phase.kicker}</p>
          <h2 class="font-display text-2xl leading-tight text-ink">{phase.title}</h2>
          <p class="mt-3 text-sm leading-7 text-ink-soft">{phase.body}</p>
        </article>
      ))
    }
  </section>

  <section class="mb-9 grid gap-5 md:grid-cols-2">
    <article class="border border-line bg-paper-panel/90 p-6 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">Where AI helps</p>
      <h2 class="font-display text-4xl leading-tight text-ink">Acceleration, not abdication</h2>
      <ul class="mt-4 space-y-3 pl-5 text-sm leading-7 text-ink">
        {aiHelps.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article class="border border-line bg-paper-panel/90 p-6 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">What stays with me</p>
      <h2 class="font-display text-4xl leading-tight text-ink">Engineer-owned responsibilities</h2>
      <ul class="mt-4 space-y-3 pl-5 text-sm leading-7 text-ink">
        {engineerOwns.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>

  <section class="border border-line bg-paper-panel/90 p-6 shadow-[0_18px_48px_rgba(31,40,43,0.08)]">
    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">Engineering standard</p>
    <h2 class="font-display text-4xl leading-tight text-ink">Most teams do not need more tooling. They need cleaner structure.</h2>
    <p class="mt-4 max-w-3xl text-sm leading-7 text-ink-soft">
      Most product problems do not come from missing frameworks. They come from weak boundaries, unclear ownership,
      fragile delivery, and performance or reliability work that keeps getting postponed. Good engineering fixes those
      conditions before they become the roadmap.
    </p>
  </section>
</SiteLayout>
