---
import SiteLayout from '../layouts/SiteLayout.astro';

const phases = [
  {
    kicker: '1. Assess',
    title: 'Inspect before changing',
    body: 'I start by reading the existing system, constraints, and failure modes. Fast guesses are cheap. Cleaning up after them is not.',
  },
  {
    kicker: '2. Shape',
    title: 'Reduce ambiguity early',
    body: 'I define the problem, tighten the scope, and call out tradeoffs before implementation drifts into vague motion.',
  },
  {
    kicker: '3. Build',
    title: 'Prefer structure that survives',
    body: 'I favor maintainable boundaries, clear ownership, and delivery patterns that prevent the codebase from turning into a daily struggle.',
  },
  {
    kicker: '4. Review',
    title: 'Correctness is not delegated',
    body: 'Changes still need technical scrutiny, product judgment, and operational thinking. Shipping faster only matters if the result still deserves to exist.',
  },
];

const aiHelps = [
  'Shaping options when a problem space is still broad',
  'Drafting implementation paths and reducing startup drag',
  'Refactoring support, codebase exploration, and repetitive scaffolding',
  'Synthesis across docs, code, and open decisions',
  'Review support for consistency checks and obvious gaps',
];

const engineerOwns = [
  'Architecture and system boundaries',
  'Product tradeoffs and implementation judgment',
  'Correctness and review quality',
  'Production accountability',
  'Deciding what not to build',
];
---

<SiteLayout
  title="Workflow | Jariel Balberona"
  description="How Jariel Balberona approaches architecture, maintainability, delivery, and AI-assisted engineering work."
  activeNav="workflow"
  footerLeft="Planning, implementation, review"
  footerRight="AI is useful. Judgment still matters more."
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Workflow</p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-tight">
      Use AI where it helps. Keep engineering ownership.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      I use AI for planning, synthesis, review support, and implementation acceleration. I do not use it as a
      substitute for architecture, product reasoning, review quality, or production ownership.
    </p>
  </section>

  <section class="mb-20 grid gap-8 md:grid-cols-2 xl:grid-cols-4">
    {
      phases.map((phase) => (
        <article class="border-t border-line pt-5">
          <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">{phase.kicker}</p>
          <h2 class="text-xl font-semibold tracking-tight text-ink">{phase.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{phase.body}</p>
        </article>
      ))
    }
  </section>

  <section class="mb-24 grid gap-12 md:grid-cols-2">
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Where AI helps</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Acceleration, not abdication</h2>
      <ul class="mt-5 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
        {aiHelps.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">What stays with me</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Engineer-owned responsibilities</h2>
      <ul class="mt-5 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
        {engineerOwns.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>

  <section class="border-t border-line pt-10">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Engineering standard</p>
    <h2 class="text-2xl font-semibold tracking-tight text-ink">Most teams do not need more tooling. They need cleaner structure.</h2>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      Product problems rarely stem from missing frameworks. They come from weak boundaries, unclear ownership,
      fragile delivery, and performance or reliability work that keeps getting postponed. Good engineering fixes these
      conditions before they consume the roadmap.
    </p>
  </section>
</SiteLayout>
