---
import SiteLayout from '../layouts/SiteLayout.astro';

const phases = [
  {
    kicker: '1. Understand the system',
    title: 'Read before changing',
    body: 'I start by inspecting the current code, constraints, and failure modes. Most bad engineering decisions come from acting on assumptions instead of reality.',
    points: [
      'what already exists',
      'what is actually broken',
      'what the real scope is',
      'what should stay untouched',
    ],
    outro: 'I do not treat speed as an excuse to skip system understanding.',
  },
  {
    kicker: '2. Define the change',
    title: 'Reduce ambiguity before execution',
    body: 'Before implementation, I narrow the problem, expose tradeoffs, and define what success actually means. This prevents movement without direction, which is where a lot of engineering waste starts.',
    points: [
      'clear scope',
      'explicit boundaries',
      'known risks',
      'fewer hidden surprises later',
    ],
  },
  {
    kicker: '3. Execute in small, isolated units',
    title: 'One change, one scope, one outcome',
    body: 'I prefer ticket-driven execution with isolated branches or worktrees, especially when using AI coding agents. Each change should have a clear purpose, minimal blast radius, and an obvious verification path.',
    points: [
      'scoped work instead of vague "cleanup"',
      'isolated implementation instead of overlapping edits',
      'traceable progress instead of hidden churn',
    ],
    outro: 'AI helps accelerate execution, but the workflow stays structured.',
  },
  {
    kicker: '4. Verify aggressively',
    title: 'Fast is useless if the result is wrong',
    body: 'I treat verification as part of implementation, not as a final courtesy. Type safety, runtime behavior, edge cases, integration impact, and stale assumptions all need to be checked.',
    points: [
      'verify the current state first',
      'implement narrowly',
      'verify again after the change',
      'clean up dead code and drift when needed',
    ],
    outro: 'A change is not done because code was written. It is done when it holds up under scrutiny.',
  },
  {
    kicker: '5. Review for long-term survivability',
    title: 'Ship work that the codebase can survive',
    body: 'I care less about cleverness and more about whether the system remains maintainable under real product pressure. Good delivery is not just feature output. It is preserving clarity, ownership, and reliability while moving forward.',
    points: [
      'does this strengthen or weaken boundaries?',
      'does this reduce or increase future maintenance cost?',
      'does this make the system easier or harder to reason about?',
      'are we solving the real problem or creating a bigger one later?',
    ],
  },
];

const aiHelps = [
  'codebase exploration and pattern discovery',
  'implementation drafting and refactor support',
  'turning vague tasks into structured execution plans',
  'surfacing inconsistencies across code, docs, and tickets',
  'review support for obvious gaps, dead code, and drift',
  'reducing startup friction on well-scoped work',
];

const engineerOwns = [
  'Architecture and system boundaries',
  'Implementation judgment',
  'Product and technical tradeoffs',
  'Correctness and review quality',
  'Deployment confidence',
  'Production accountability',
  'Deciding what not to build',
];
---

<SiteLayout
  title="Workflow | Jariel Balberona"
  description="How Jariel Balberona approaches planning, implementation, review, and disciplined AI-assisted engineering work."
  activeNav="workflow"
  footerLeft="Planning, implementation, review"
  footerRight="AI is useful. Judgment still matters more."
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Workflow</p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-tight">
      Use AI to reduce drag. Keep engineering judgment and accountability human.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      I use AI heavily in day-to-day engineering work, but within a disciplined workflow. It helps me move faster through exploration, drafting, refactoring, and implementation support. It does not own architecture, correctness, or production responsibility. I do.
    </p>
  </section>

  <section class="mb-20 grid gap-8 md:grid-cols-2">
    {
      phases.map((phase) => (
        <article class="border-t border-line pt-5">
          <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">{phase.kicker}</p>
          <h2 class="text-xl font-semibold tracking-tight text-ink">{phase.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{phase.body}</p>
          {phase.points && (
            <ul class="mt-5 space-y-2 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
              {phase.points.map((item) => <li>{item}</li>)}
            </ul>
          )}
          {phase.outro && <p class="mt-5 text-sm leading-relaxed text-ink-soft">{phase.outro}</p>}
        </article>
      ))
    }
  </section>

  <section class="mb-24 grid gap-12 md:grid-cols-2">
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Where AI helps</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Acceleration with constraints</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        I use AI to speed up parts of the workflow that benefit from iteration and synthesis:
      </p>
      <ul class="mt-5 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
        {aiHelps.map((item) => <li>{item}</li>)}
      </ul>
      <p class="mt-5 text-sm leading-relaxed text-ink-soft">Used properly, AI removes drag. Used poorly, it multiplies noise.</p>
    </article>
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">What stays with me</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Ownership does not move</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">There are responsibilities I do not outsource:</p>
      <ul class="mt-5 space-y-3 pl-5 text-sm leading-relaxed text-ink list-disc marker:text-line">
        {engineerOwns.map((item) => <li>{item}</li>)}
      </ul>
      <p class="mt-5 text-sm leading-relaxed text-ink-soft">AI can assist the work. It does not own the outcome.</p>
    </article>
  </section>

  <section class="border-t border-line pt-10">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Engineering standard</p>
    <h2 class="text-2xl font-semibold tracking-tight text-ink">The bottleneck is usually not speed. It is weak structure.</h2>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      Most teams do not struggle because they lack another tool. They struggle because scope is loose, boundaries are weak, ownership is unclear, and verification is treated as optional until the system starts fighting back.
    </p>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      That is why my workflow emphasizes inspection, scoped execution, verification, and maintainable structure.
    </p>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      I use AI to move faster, but never at the cost of engineering quality. Faster output only matters if the system stays reliable, understandable, and worth building on.
    </p>
  </section>
</SiteLayout>
