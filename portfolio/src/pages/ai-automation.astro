---
import SiteLayout from '../layouts/SiteLayout.astro';

const stackGroups = [
  {
    title: 'LLM / Model Platforms',
    body: 'These are the model platforms I actively use for shipped workflows, engineering support, and applied automation work.',
    items: ['OpenAI', 'Claude', 'Gemini', 'DeepSeek'],
  },
  {
    title: 'Voice / Audio AI',
    body: 'I use voice and transcription tooling when the workflow needs speech input, transcription, or audio output.',
    items: ['AssemblyAI', 'ElevenLabs'],
  },
  {
    title: 'Image / Multimodal',
    body: 'For image or multimodal workflows, I use Gemini image models, including Nano Banana, when the system actually benefits from them.',
    items: ['Gemini image models / Nano Banana'],
  },
  {
    title: 'Automation / Integrations',
    body: 'These are the integration and orchestration tools that show up most often in real workflow implementation.',
    items: ['n8n', 'Make', 'Zapier', 'Webhooks', 'Slack', 'Linear'],
  },
];

const supportingStackGroups = [
  {
    title: 'Memory / Context',
    items: ['LangGraph', 'Mem0', 'Zep'],
  },
  {
    title: 'Retrieval / Knowledge',
    items: ['PostgreSQL + pgvector', 'Pinecone'],
  },
  {
    title: 'Observability / Evaluation',
    items: ['LangSmith'],
  },
  {
    title: 'Durable Workflow Runtime',
    items: ['Temporal'],
  },
];

const workflowPatterns = [
  {
    title: 'Event-driven workflows triggered from business truth',
    trigger: 'A real product event happens: an order changes state, stock moves, a support case appears, or a system status crosses a threshold.',
    flow: 'The system emits the downstream signal, orchestration handles notifications, reporting, follow-on tasks, or operator updates, and the core app remains the source of record.',
    ai: 'Usually none at the trigger level. AI becomes useful later for summarizing, explaining, or prioritizing the operational state created by the event stream.',
    deterministic: 'State changes, side effects, and integration calls stay deterministic and traceable.',
    human: 'Operators still decide on interventions that change money, service flow, customer communication, or operational policy.',
    guardrails: 'Idempotency, retry discipline, visible failure logs, and no hidden business truth inside the automation layer.',
  },
  {
    title: 'AI summaries tied to real operational data',
    trigger: 'A user, operator, or support workflow needs a fast explanation of what happened across a noisy set of records or events.',
    flow: 'The system gathers the relevant operational context, prepares a constrained input, and generates a summary or explanation that helps a person understand the state faster.',
    ai: 'AI handles condensation, synthesis, and explanation where raw records are too dense to scan quickly.',
    deterministic: 'Record selection, business calculations, and filtering rules remain deterministic.',
    human: 'Humans read the summary, verify it against source state when needed, and make the actual decision.',
    guardrails: 'Ground the prompt on known records, keep the input narrow, and expose the underlying source data when the summary matters.',
  },
  {
    title: 'Classification, routing, and exception handling',
    trigger: 'An incoming request, issue, message, or workflow state needs triage.',
    flow: 'A classifier or rules layer tags the item, proposes a route, and sends it into the right queue, team, or next step. Exceptions break out to a visible review path instead of silently failing.',
    ai: 'AI is useful for soft classification, extraction, and suggestion when the input is messy or semi-structured.',
    deterministic: 'Routing rules, escalation conditions, and hard-stop scenarios stay explicit.',
    human: 'Humans remain in the loop for ambiguous cases, destructive actions, and policy-sensitive paths.',
    guardrails: 'Confidence thresholds, fallback buckets, and auditability on why something was routed a certain way.',
  },
  {
    title: 'Ticket-driven engineering acceleration with AI support',
    trigger: 'A scoped engineering ticket exists with enough context to execute.',
    flow: 'I use AI to inspect codebases, draft changes, synthesize context, and accelerate review, but the work still moves through scoped implementation, verification, and explicit ownership.',
    ai: 'Exploration, drafting, summarization, review support, and startup acceleration on well-bounded tasks.',
    deterministic: 'Source control, tests, verification steps, and release flow remain standard engineering process.',
    human: 'I still own architecture, tradeoffs, correctness, and whether the generated output is worth merging.',
    guardrails: 'Ticket scope, isolated branches or worktrees, verification before and after changes, and no blind acceptance of generated code.',
  },
];

const concreteExamples = [
  {
    title: 'Dumadine operational reporting and support context',
    context: 'A hospitality operating system only becomes automation-ready when ordering, kitchen flow, stock movement, and accounting behavior live in coherent system state.',
    implementation: 'The engineering value is in preserving those boundaries so reporting, summaries, operator explanations, and support tooling can pull from actual product truth instead of stitched-together side systems.',
    ai: 'AI fits at the explanation and synthesis layer: helping operators or support staff understand what happened across dense operational activity.',
    value: 'This reduces manual reconstruction work and makes downstream tooling more credible because it is grounded in the real system.',
  },
  {
    title: 'Issue-to-ticket-to-fix engineering flow',
    context: 'A problem starts as an issue, support report, or implementation request and needs to become shippable engineering work.',
    implementation: 'I use Linear, Git, isolated worktrees or branches, and AI-assisted exploration to turn vague reports into scoped execution, then verify changes before they move forward.',
    ai: 'AI helps with codebase inspection, synthesis, draft implementation, and review support, not final authority.',
    value: 'The gain is less startup drag and cleaner execution without losing ownership or verification discipline.',
  },
  {
    title: 'Engineering review, synthesis, and planning flows',
    context: 'Complex work often arrives as scattered code, docs, tickets, comments, and operational notes.',
    implementation: 'I use AI to compress that mess into structured plans, review lenses, and implementation sequences, then execute through normal engineering controls.',
    ai: 'The model helps with synthesis and candidate structure. The engineering judgment stays with me.',
    value: 'This is valuable because it converts vague or distributed context into faster, more reliable delivery.',
  },
  {
    title: 'Event-driven downstream actions from core system truth',
    context: 'Operational systems need follow-on actions after the main transaction, but those actions should not become a second source of business truth.',
    implementation: 'I prefer application state changes or domain events to trigger downstream workflows in n8n, Make, Zapier, or direct integration layers.',
    ai: 'AI is optional here. The backbone is deterministic orchestration. AI is only added when a human-facing interpretation layer helps.',
    value: 'This keeps the system shape sane: the product owns truth, automation owns execution, and operators can still trace what happened.',
  },
];
---

<SiteLayout
  title="AI Automation | Jariel Balberona"
  description="How Jariel Balberona uses automation and AI in real systems through event-driven workflows, product-integrated operational tooling, and disciplined engineering acceleration."
  activeNav="ai-automation"
>
  <section class="mb-20">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">AI Automation</p>
    <h1 class=" text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-ink leading-tight">
      I use AI and automation in two lanes: internal engineering acceleration and shipped operational workflows.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Those lanes are related, but they are not interchangeable. One helps me move faster as an engineer. The other has to hold up inside real products, real data flow, real failure cases, and real operator decisions.
    </p>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink">
      The useful work is not AI theater. It is production-minded engineering: event-driven workflows, orchestration, summaries, routing, support context, and decision-support layers built on top of actual system truth.
    </p>
  </section>

  <section class="mb-20 border-t border-line pt-10">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">How I split the work</p>
    <div class="grid gap-8 md:grid-cols-2">
      <article class="border-t border-line pt-5">
        <h2 class="text-xl font-semibold tracking-tight text-ink">Internal engineering acceleration</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">
          I use AI as a disciplined engineering tool for codebase exploration, drafting, synthesis, structured review, and reducing startup friction on scoped work.
        </p>
      </article>
      <article class="border-t border-line pt-5">
        <h2 class="text-xl font-semibold tracking-tight text-ink">Shipped product and operational workflows</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">
          I build automation and AI support into real systems where triggers, state, side effects, guardrails, and human review paths matter more than the model headline.
        </p>
      </article>
    </div>
  </section>

  <section class="mb-20 border-t border-line pt-10">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Stack</p>
    <h2 class="max-w-2xl text-2xl font-semibold tracking-tight text-ink">These are the platforms and tools I actively use in AI and automation work.</h2>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-soft">
      The core stays rooted in software engineering: application code, integration logic, data flow, and operational guardrails. These are the tools that show up most often.
    </p>
    <div class="mt-8 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
      {stackGroups.map((group) => (
        <article class="border-t border-line pt-5">
          <h3 class="text-lg font-semibold tracking-tight text-ink">{group.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{group.body}</p>
          <ul class="mt-4 flex flex-wrap gap-2 text-sm leading-relaxed text-ink">
            {group.items.map((item) => <li class="border border-line px-2.5 py-1">{item}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="mt-12 border-t border-line pt-10">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Supporting system layers</p>
      <h3 class="max-w-2xl text-xl font-semibold tracking-tight text-ink">These are tools I work with when the workflow needs memory, retrieval, evaluation, or durable execution.</h3>
      <div class="mt-8 grid gap-8 md:grid-cols-2 xl:grid-cols-4">
        {supportingStackGroups.map((group) => (
          <article class="border-t border-line pt-5">
            <h4 class="text-base font-semibold tracking-tight text-ink">{group.title}</h4>
            <ul class="mt-4 flex flex-wrap gap-2 text-sm leading-relaxed text-ink">
              {group.items.map((item) => <li class="border border-line px-2.5 py-1">{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mb-20 border-t border-line pt-10">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Workflow patterns</p>
    <h2 class="max-w-2xl text-2xl font-semibold tracking-tight text-ink">The repeated pattern is simple: deterministic backbone first, AI where interpretation helps, humans where judgment matters.</h2>
    <div class="mt-8 space-y-10">
      {workflowPatterns.map((item) => (
        <article class="border-t border-line pt-5">
          <h3 class="text-xl font-semibold tracking-tight text-ink">{item.title}</h3>
          <div class="mt-4 grid gap-3 text-sm leading-relaxed text-ink-soft md:grid-cols-2">
            <p><strong class="font-medium text-ink">Trigger / input:</strong> {item.trigger}</p>
            <p><strong class="font-medium text-ink">What happens:</strong> {item.flow}</p>
            <p><strong class="font-medium text-ink">Where AI is used:</strong> {item.ai}</p>
            <p><strong class="font-medium text-ink">What stays deterministic:</strong> {item.deterministic}</p>
            <p><strong class="font-medium text-ink">Human control:</strong> {item.human}</p>
            <p><strong class="font-medium text-ink">Guardrails:</strong> {item.guardrails}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mb-20 border-t border-line pt-10">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Concrete examples</p>
    <h2 class="max-w-2xl text-2xl font-semibold tracking-tight text-ink">The important part is not abstract belief. It is where these patterns show up in real work.</h2>
    <div class="mt-8 space-y-10">
      {concreteExamples.map((item) => (
        <article class="border-t border-line pt-5">
          <h3 class="text-xl font-semibold tracking-tight text-ink">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft"><strong class="font-medium text-ink">Context:</strong> {item.context}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft"><strong class="font-medium text-ink">Implementation shape:</strong> {item.implementation}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft"><strong class="font-medium text-ink">AI role:</strong> {item.ai}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft"><strong class="font-medium text-ink">Engineering value:</strong> {item.value}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="grid gap-12 md:grid-cols-2">
    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Boundaries</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">I am not selling research credentials. I am selling applied engineering judgment.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        The value is in building systems that can safely use automation and AI without letting either one become a hidden, unreviewable mess. That means clear ownership, narrow model responsibilities, deterministic system edges, and visible fallback behavior.
      </p>
    </article>

    <article class="border-t border-line pt-8">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Practical outcomes</p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">The point is better system behavior, less coordination drag, and clearer operational visibility.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        I use automation and AI where they reduce manual reconstruction work, clarify system state, or speed up disciplined engineering execution. If they make the system harder to reason about, they do not belong there.
      </p>
    </article>
  </section>
</SiteLayout>
