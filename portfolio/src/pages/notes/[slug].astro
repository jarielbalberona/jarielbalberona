---
import { getCollection, render } from 'astro:content';
import NoteLayout from '../../layouts/NoteLayout.astro';
import { isPublishedNote, noteSlug, sortNotesNewestFirst } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter(isPublishedNote).sort(sortNotesNewestFirst);

  return Promise.all(notes.map(async (entry, index) => {
    const { headings } = await render(entry);
    const related = notes
      .filter((candidate) => candidate.id !== entry.id && candidate.data.tags.some((tag) => entry.data.tags.includes(tag)))
      .slice(0, 2);

    return {
      params: { slug: noteSlug(entry) },
      props: {
        entry,
        headings,
        related,
        previous: notes[index + 1],
        next: notes[index - 1],
      },
    };
  }));
}

const { entry, headings, related, previous, next } = Astro.props;
const { Content } = await render(entry);
---

<NoteLayout entry={entry} headings={headings} related={related} previous={previous} next={next}>
  <Content />
</NoteLayout>
