---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { formatNoteDate, isPublishedNote, noteUrl, readingTime, sortNotesNewestFirst } from '../../lib/notes';

const notes = (await getCollection('notes')).filter(isPublishedNote).sort(sortNotesNewestFirst);
const featured = notes.find((entry) => entry.data.featured) ?? notes[0];
---

<SiteLayout
  title="Notes | Jariel Balberona"
  description="Technical notes on agentic engineering, AI-native software delivery, verification, bounded autonomy, and production accountability."
  activeNav="notes"
>
  <section class="mb-16">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Notes</p>
    <h1 class="max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">Engineering methods, constraints, and proof.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">Long-form technical writing about building software with agents while preserving architectural control, verification discipline, and production accountability.</p>
  </section>

  {featured && (
    <section class="mb-16 border-y border-line py-8" aria-labelledby="featured-note-heading">
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Featured note</p>
      <h2 id="featured-note-heading" class="max-w-3xl text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">{featured.data.title}</h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-soft">{featured.data.summary}</p>
      <div class="mt-5 flex flex-wrap gap-3 text-sm text-ink-soft">
        <time datetime={featured.data.publishedDate.toISOString()}>{formatNoteDate(featured.data.publishedDate)}</time>
        <span>{readingTime(featured.body ?? '').label}</span>
      </div>
      <a href={noteUrl(featured)} class="mt-6 inline-flex bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:bg-ink-soft">Read the note</a>
    </section>
  )}

  <section aria-labelledby="published-notes-heading">
    <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">Published</p>
    <h2 id="published-notes-heading" class="text-2xl font-semibold tracking-tight text-ink">All notes</h2>
    <ol class="mt-8 space-y-10">
      {notes.map((entry) => (
        <li class="border-t border-line pt-5">
          <article>
            <h3 class="text-xl font-semibold tracking-tight text-ink"><a href={noteUrl(entry)} class="underline decoration-line underline-offset-4 hover:decoration-ink">{entry.data.title}</a></h3>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-soft">{entry.data.summary}</p>
            <div class="mt-4 flex flex-wrap gap-3 text-xs text-ink-soft">
              <time datetime={entry.data.publishedDate.toISOString()}>{formatNoteDate(entry.data.publishedDate)}</time>
              <span>{readingTime(entry.body ?? '').label}</span>
            </div>
            <ul class="mt-4 flex flex-wrap gap-2" aria-label={`Tags for ${entry.data.title}`}>
              {entry.data.tags.map((tag) => <li class="border border-line px-2 py-1 font-mono text-xs text-ink-soft">{tag}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </section>
</SiteLayout>
