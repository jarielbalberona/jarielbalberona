---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { formatNoteDate, isPublishedNote, noteUrl, readingTime, sortNotesNewestFirst } from '../../lib/notes';

const notes = (await getCollection('notes')).filter(isPublishedNote).sort(sortNotesNewestFirst);

const groups = [
  {
    id: 'practice',
    label: 'In practice',
    heading: 'How the work actually runs.',
    notes: notes.filter((entry) => entry.data.kind === 'practice'),
  },
  {
    id: 'method',
    label: 'Method',
    heading: 'The model behind it.',
    notes: notes.filter((entry) => entry.data.kind === 'method'),
  },
].filter((group) => group.notes.length > 0);
---

<SiteLayout
  title="Notes | Jariel Balberona"
  description="Technical notes on agentic engineering, AI-native software delivery, verification, bounded autonomy, and production accountability."
  activeNav="notes"
>
  <section class="mb-16">
    <p class="mb-5 text-xs font-mono uppercase tracking-widest text-ink-soft">Notes</p>
    <h1 class="max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">Engineering methods, constraints, and proof.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">Long-form technical writing about building software with agents while preserving architectural control, verification discipline, and production accountability.</p>
  </section>

  {groups.map((group) => (
    <section class="mb-16 border-t border-line pt-8" aria-labelledby={`${group.id}-notes-heading`}>
      <p class="mb-3 text-xs font-mono uppercase tracking-widest text-ink-soft">{group.label}</p>
      <h2 id={`${group.id}-notes-heading`} class="text-2xl font-semibold tracking-tight text-ink">{group.heading}</h2>
      <ol class="mt-8 space-y-10">
        {group.notes.map((entry) => (
          <li class="border-t border-line pt-5">
            <article>
              <h3 class="text-xl font-semibold tracking-tight text-ink"><a href={noteUrl(entry)} class="underline decoration-line underline-offset-4 hover:decoration-ink">{entry.data.title}</a></h3>
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-soft">{entry.data.summary}</p>
              <div class="mt-4 flex flex-wrap gap-3 text-xs text-ink-soft">
                <time datetime={entry.data.publishedDate.toISOString()}>{formatNoteDate(entry.data.publishedDate)}</time>
                {entry.data.updatedDate && <span>Updated <time datetime={entry.data.updatedDate.toISOString()}>{formatNoteDate(entry.data.updatedDate)}</time></span>}
                <span>{readingTime(entry.body ?? '').label}</span>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>
  ))}
</SiteLayout>
