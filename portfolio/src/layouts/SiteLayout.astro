---
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteMeta } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  activeNav: string;
  footerLeft?: string;
  footerRight?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  publishedDate?: Date;
  updatedDate?: Date;
  additionalStructuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  activeNav,
  footerLeft = siteMeta.name,
  footerRight = siteMeta.email,
  ogImage = siteMeta.ogImage,
  ogImageAlt = `${siteMeta.name}, Staff-Level AI-Native Software Engineer`,
  ogType = 'website',
  canonical,
  publishedDate,
  updatedDate,
  additionalStructuredData = [],
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteMeta.url).toString();
const ogImageUrl = new URL(ogImage, siteMeta.url).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteMeta.url}/#person`,
      name: siteMeta.name,
      url: siteMeta.url,
      jobTitle: 'Staff-Level AI-Native Software Engineer',
      sameAs: [siteMeta.linkedin, siteMeta.github],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteMeta.url}/#website`,
      url: siteMeta.url,
      name: siteMeta.title,
      description: siteMeta.description,
      publisher: { '@id': `${siteMeta.url}/#person` },
    },
    ...additionalStructuredData,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="GzufsVA1_dOCwjO51JI8F804YZ7-cHlSjqsKZqGVpQQ" />
    <meta name="theme-color" content={siteMeta.themeColor} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteMeta.title} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Jariel Balberona Notes" href={`${siteMeta.url}/rss.xml`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <GoogleAnalytics />
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader activeNav={activeNav} />
    <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-4xl px-6 py-12 md:py-20 flex-grow">
      <slot />
    </main>
    <SiteFooter left={footerLeft} right={footerRight} />
  </body>
</html>
